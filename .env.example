# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=3000

# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/jarayid?connection_limit=10&pool_timeout=10"

# JWT Configuration
JWT_SECRET=supersecretjwtkey123456
EXPIRES_IN=7d

# Bcrypt Configuration
SALT=10

# Cloudinary Configuration (for file uploads)
CLOUD_NAME=fakecloudname
CLOUD_SECRET=fakecloudsecret
CLOUD_API_KEY=1234567890
CLOUD_FOLDER=jarayid

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_SERVICE=gmail
SMTP_PASS=fakepassword123
SMTP_FROM=admin@example.com

# Password Reset Configuration
PASSWORD_RESET_SECRET=supersecretresetkey123456
PASSWORD_RESET_EXPIRATION=1h
FRONTEND_URL=http://localhost:3000

# Note: 
# - For Gmail, use App Passwords instead of regular password
# - PASSWORD_RESET_SECRET should be a long, random string
# - PASSWORD_RESET_EXPIRATION can be: 30m, 1h, 2h, 1d, etc.
# - FRONTEND_URL should point to your frontend application URL
