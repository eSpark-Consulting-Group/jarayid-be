# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=3000

# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/jarayid?connection_limit=10&pool_timeout=10"

# JWT Configuration
JWT_SECRET=supersecretjwtkey123456
EXPIRES_IN=7d

# Bcrypt Configuration
SALT=10

# Cloudinary Configuration (for file uploads)
CLOUD_NAME=fakecloudname
CLOUD_SECRET=fakecloudsecret
CLOUD_API_KEY=1234567890
CLOUD_FOLDER=jarayid

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_SERVICE=gmail
SMTP_PASS=fakepassword123
SMTP_FROM=admin@example.com

# Password Reset Configuration
PASSWORD_RESET_SECRET=supersecretresetkey123456
PASSWORD_RESET_EXPIRATION=1h
FRONTEND_URL=http://localhost:3000

# Redis Configuration for Bull Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# RSS Processing Configuration
RSS_CONCURRENCY=3
RSS_BATCH_SIZE=5
RSS_CRON_SCHEDULE=*/15 * * * *
RSS_JOB_TIMEOUT=300000
RSS_RETRY_ATTEMPTS=3
RSS_RETRY_DELAY=60000

# OpenAI Configuration for Article Summarization
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=300
OPENAI_TEMPERATURE=0.3
OPENAI_ENABLED=false
OPENAI_TIMEOUT=30000

# Configuration Notes:
# ==================
# 
# Database:
# - Use PostgreSQL connection string format
# - Adjust connection_limit and pool_timeout based on your needs
# 
# Security:
# - JWT_SECRET: Use a long, random string (minimum 32 characters)
# - PASSWORD_RESET_SECRET: Different from JWT_SECRET, also long and random
# - Change all default secrets in production!
# 
# Email (SMTP):
# - For Gmail: Use App Passwords instead of regular password
# - SMTP_SECURE: true for port 465, false for port 587
# - SMTP_SERVICE: 'gmail', 'outlook', 'yahoo', or 'mail' for custom
# 
# Cloudinary:
# - Get credentials from cloudinary.com dashboard
# - CLOUD_FOLDER: Organize your uploads in folders
# 
# Redis:
# - Required for RSS processing background jobs
# - Use Redis Cloud or local Redis server
# - Leave REDIS_PASSWORD empty if no authentication
# 
# RSS Processing:
# - RSS_CONCURRENCY: Number of feeds processed simultaneously (1-5 recommended)
# - RSS_BATCH_SIZE: Articles processed per batch (3-10 recommended)
# - RSS_CRON_SCHEDULE: Cron format for processing interval
# - RSS_JOB_TIMEOUT: Timeout in milliseconds (300000 = 5 minutes)
# - RSS_RETRY_ATTEMPTS: Number of retries for failed feeds
# - RSS_RETRY_DELAY: Delay between retries in milliseconds
# 
# OpenAI:
# - Get API key from platform.openai.com/api-keys
# - OPENAI_MODEL: 'gpt-4o-mini', 'gpt-3.5-turbo', 'gpt-4-turbo'
# - OPENAI_MAX_TOKENS: Summary length (150-500 recommended)
# - OPENAI_TEMPERATURE: Creativity level (0.1-0.5 for summaries)
# - OPENAI_ENABLED: Set to 'true' to enable AI summarization
# - OPENAI_TIMEOUT: API timeout in milliseconds

# Paddle Payment Gateway Configuration
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
PADDLE_MONTHLY_PRICE_ID=pri_monthly_price_id_here
PADDLE_YEARLY_PRICE_ID=pri_yearly_price_id_here

# Frontend URLs for redirects
FRONTEND_URL=http://localhost:3000
PADDLE_SUCCESS_URL=http://localhost:3000/subscription/success
PADDLE_FAILURE_URL=http://localhost:3000/subscription/failed
PADDLE_CANCEL_URL=http://localhost:3000/subscription/cancelled
