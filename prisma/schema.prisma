generator client {
  provider = "prisma-client-js"
}
 
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
model User {
  id                   String           @id @default(uuid())
  name                 Json?
  email                String           @unique
  password             String? // Made optional for social login
  role                 UserRole         @default(USER)
  isSocialLogin        Boolean          @default(false)
  loginType            String?
  socialId             String?          @db.VarChar(500) // Added socialId for social login
  isBanned             Boolean          @default(false)
  image                String?          @db.VarChar(500)
  imageKey             String?          @db.VarChar(500)
  lastLoginAt          DateTime?
  country              String?          @db.VarChar(100)
  isDeleted            Boolean?          @default(false)
  phoneNumber          String?          @db.VarChar(20)
  resetPasswordToken   String?          @db.VarChar(500)
  resetPasswordExpires DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  articleViews         ArticleView[]
  articles             Article[]
  categories           Category[]
  comments             Comment[]
  contacts             Contact[]
  favorites            Favorite[]
  readLater            ReadLater[]
  subscriptions        Subscription[]
  youtubeContents      YouTubeContent[]
 
  @@map("users")
}
 
model Category {
  id              String           @id @default(uuid())
  name            String           @db.VarChar(500)
  type            CategoryType
  logo            String?          @db.VarChar(500)
  logoKey         String?          @db.VarChar(500)
  videoUrl        String?          @db.VarChar(500)
  description     String?
  seoMeta         Json
  thresholdDays   Int
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  articles        Article[]
  createdBy       User             @relation(fields: [createdById], references: [id])
  rssFeeds        RSSFeed[]
  youtubeContents YouTubeContent[]
 
  @@map("categories")
}
 
model RSSFeed {
  id         String           @id @default(uuid())
  name       String           @db.VarChar(500)
  url        String           @db.VarChar(500)
  status     Status           @default(DRAFT)
  logo       String?          @db.VarChar(500)
  logoKey    String?          @db.VarChar(500)
  categoryId String
  subType    CategorySubType?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  articles   Article[]
  category   Category         @relation(fields: [categoryId], references: [id])
 
  @@map("rss_feeds")
}
 
model Article {
  id              String           @id @default(uuid())
  title           String           @db.VarChar(500)
  url             String?          @db.VarChar(500)
  source          String           @db.VarChar(500)
  originalContent Json
  summaryArabic   String?
  summaryEnglish  String?
  image           String?          @db.VarChar(500)
  imageKey        String?          @db.VarChar(500)
  categoryId      String?
  subType         CategorySubType?
  rssFeedId       String?
  status          Boolean           @default(true)
  pinned          Boolean          @default(false)
  viewCount       Int              @default(0)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  userId          String
  articleViews    ArticleView[]
  category        Category?        @relation(fields: [categoryId], references: [id])
  rssFeed         RSSFeed?         @relation(fields: [rssFeedId], references: [id])
  author          User             @relation(fields: [userId], references: [id])
  comments        Comment[]
  favorites       Favorite[]
  readLater       ReadLater[]
 
  @@map("articles")
}
 
model Comment {
  id        String   @id @default(uuid())
  articleId String
  userId    String
  content   String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
 
  @@map("comments")
}
 
model Contact {
  id             String   @id @default(uuid())
 
  userId         String?
 
  name           String   @db.VarChar(500)
  business_name  String   @db.VarChar(150)
  contact_number String   @db.VarChar(20)
  contact_email  String   @db.VarChar(500)
  country        String   @db.VarChar(100)
  message        String
  isResponded    Boolean  @default(false)
  createdAt      DateTime @default(now())
 
  user           User?     @relation(fields: [userId], references: [id])
 
 
  @@map("contacts")
}
 
model SponsorAccount {
  id            String   @id @default(uuid())
  name          String   @db.VarChar(200)
  businessName  String   @db.VarChar(200)
  website       String?  @db.VarChar(500)
  contactEmail  String   @db.VarChar(200)
  category      String   @db.VarChar(100)
  contact       String?  @db.VarChar(500)
  status        SponsorStatus @default(ACTIVE)
  phone         String?  @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
 
  @@map("sponsor_accounts")
}
 
enum SponsorStatus {
  ACTIVE
  INACTIVE
}
 
model StaticPage {
  id        String   @id @default(uuid())
  title     String   @unique
  content   Json?
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
 
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
 
  @@map("favorites")
}
 
model ReadLater {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
 
  @@map("read_later")
}
 
model Subscription {
  id                    String               @id @default(uuid())
  userId                String
  isPremium             Boolean              @default(false)
  trialEndsAt           DateTime?
 
  // Paddle Integration Fields
  paddleSubscriptionId  String?              @unique @db.VarChar(255)
  paddleCustomerId      String?              @db.VarChar(255)
  paddlePlanId          String?              @db.VarChar(255)
  status                SubscriptionStatus   @default(INACTIVE)
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean              @default(false)
  cancelledAt           DateTime?
  pausedAt              DateTime?
  resumedAt             DateTime?
 
  // Payment Information
  currency              String?              @db.VarChar(3)
  amount                Float?
  interval              SubscriptionInterval?
 
  // Metadata
  metadata              Json?
  lastPaymentAt         DateTime?
  nextPaymentAt         DateTime?
  failedPaymentCount    Int                  @default(0)
 
 
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id])
 
 
  @@unique([userId], name: "unique_user_subscription")
  @@map("subscriptions")
}
 
model Ad {
  id        String     @id @default(uuid())
  platform  AdPlatform
  adType    AdType
  location  String     @db.VarChar(100)
  isEnabled Boolean
  revenue   Float
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
 
  @@map("ads")
}
 
model YouTubeContent {
  id           String             @id @default(uuid())
  title        String             @db.VarChar(500)
  youtubeUrl   String             @db.VarChar(500)
  contentType  YouTubeContentType
  categoryId   String
  isEnabled    Boolean            @default(true)
  viewCount    Int                @default(0)
  description  String?
  thumbnailUrl String?            @db.VarChar(500)
  deviceType   String?            @db.VarChar(50)
  duration     String?            @db.VarChar(20)
  createdById  String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  category     Category           @relation(fields: [categoryId], references: [id])
  createdBy    User               @relation(fields: [createdById], references: [id])
 
  @@map("youtube_contents")
}
 
model ArticleView {
  id        String   @id @default(uuid())
  articleId String
  userId    String?
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  viewedAt  DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
 
  @@unique([articleId, userId], name: "unique_user_article_view")
  @@unique([articleId, ipAddress], name: "unique_ip_article_view")
  @@map("article_views")
}
 
model ExternalLink {
  id               String   @id @default(uuid())
  toolName         String   @db.VarChar(255)
  toolRedirectLink String   @db.VarChar(1024)
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
 
enum Status {
  ARCHIVE
  DRAFT
  PUBLISH
}
 
enum CategoryType {
  COUNTRY
  NORMAL
  MEDIA
}
 
enum CategorySubType {
  SPORTS
  ECONOMICS
  POLITICS
}
 
enum UserRole {
  ADMIN
  USER
}
 
enum AdPlatform {
  WEB
  MOBILE
}
 
enum AdType {
  GOOGLE_ADS
  AD_MOB
}
 
enum YouTubeContentType {
  SHORTS
  FULL_VIDEO
}
 
enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  PAUSED
  PAST_DUE
  TRIALING
  EXPIRED
}

model Cookie {
  id          String     @id @default(uuid())
  name        String     @unique @db.VarChar(100)
  purpose     String     @db.VarChar(500)
  duration    String     @db.VarChar(50)
  category    CookieCategory @default(FUNCTIONAL)
  isEssential Boolean    @default(false)
  isEnabled   Boolean    @default(true)
  description String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@map("cookies")
}

 
model VisualAdPlacement {
  id           String    @id @default(uuid())
  platform     Platform
  pageType     PageType
  positionName String
  adLink       String?   // Could be ad unit ID or URL
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
 
enum Platform {
  WEB
  APP
}
 
enum PageType {
  MAIN_PAGE
  ARTICLE_PAGE
  CATEGORY
}

enum CookieCategory {
  ESSENTIAL
  FUNCTIONAL
  ANALYTICS
  MARKETING
  PREFERENCES
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
  WEEKLY
 
}